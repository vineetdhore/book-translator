# Copy this file to .env and replace the placeholder with your Google API key.
# Do not commit the .env file.
GOOGLE_API_KEY=replace_with_your_google_api_key

# Optional: choose the Google model to use for language detection and translation.
GOOGLE_GENAI_MODEL=gemini-2.5-flash

# Google models are tried in this comma-separated order after a quota-exhaustion
# response from the primary model. The primary model is skipped if repeated in
# this list. Availability and rate limits depend on your Google account.
GOOGLE_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite

# Optional no-quota fallback. Install Ollama locally and pull this model before
# enabling it. The model processes book text on this machine, not in the cloud.
# OLLAMA_FALLBACK_MODEL=translategemma:4b
# OLLAMA_HOST=http://127.0.0.1:11434
